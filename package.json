{
  "name": "lucky-break",
  "displayName": "Lucky Break",
  "description": "Take a lucky break between builds: retro pixel-art Blackjack and Roulette with virtual chips, right in your editor. No real money, ever.",
  "version": "0.2.1",
  "private": true,
  "publisher": "thesulce",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Edes2128/vscode-lucky-break.git"
  },
  "bugs": {
    "url": "https://github.com/Edes2128/vscode-lucky-break/issues"
  },
  "homepage": "https://github.com/Edes2128/vscode-lucky-break#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#101216",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "game",
    "pixel art",
    "cards"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "luckyBreak",
          "title": "Lucky Break",
          "icon": "media/lucky-break.svg"
        }
      ]
    },
    "views": {
      "luckyBreak": [
        {
          "type": "webview",
          "id": "luckyBreak.sidebar",
          "name": "Lucky Break",
          "icon": "media/lucky-break.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "luckyBreak.showSidebar",
        "title": "Open Sidebar",
        "category": "Lucky Break"
      },
      {
        "command": "luckyBreak.openPanel",
        "title": "Open in Editor",
        "category": "Lucky Break",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "luckyBreak.openPanel",
          "when": "view == luckyBreak.sidebar",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node scripts/build-extension.mjs",
    "build:webview": "vite build",
    "dev": "node scripts/dev.mjs",
    "dev:extension": "node scripts/build-extension.mjs --watch",
    "dev:webview": "vite",
    "typecheck": "tsc -p tsconfig.extension.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build && node scripts/build-extension.mjs --tests && node out/test/runTest.js",
    "test:restart": "npm run build && node scripts/build-extension.mjs --tests && node out/test/runRestart.js",
    "perf:idle": "npm run build && node scripts/build-extension.mjs --tests && node out/test/measureIdle.js",
    "vscode:prepublish": "node scripts/build-extension.mjs --production && vite build",
    "notices": "node scripts/gen-notices.mjs",
    "package": "vsce package --no-dependencies",
    "test:vsix": "npm run package && node scripts/build-extension.mjs --tests && node out/test/runVsix.js",
    "test:integration:minified": "node scripts/build-extension.mjs --production --dev-tools && npm run build:webview && node scripts/build-extension.mjs --tests && node out/test/runTest.js"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.90.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
